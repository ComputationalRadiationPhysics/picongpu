/** @file
 *
 * Test-only precision override for the analytic Poisson regression test.
 *
 * The production default remains 32-bit (include/picongpu/param/precision.param).
 * This input set selects 64-bit for the simulation data so that the residual R
 * reflects the solver and the analytic setup, not the float32 rounding floor of
 * the charge-density right-hand side. On hal (A30, sm_80) the float32 runs had
 * a coherent RHS scale bias of -5.2e-7 / -2.4e-6 / -7.4e-6, which puts R at
 * 2.4e-6..7.4e-6 and above the 1e-6 limit. With 64-bit data that bias is far
 * below the limit.
 */

#pragma once

#include <picongpu/simulation_types.hpp>

namespace picongpu
{
    namespace precisionPIConGPU = precision64Bit;

    namespace precisionSqrt = precisionPIConGPU;
    namespace precisionExp = precisionPIConGPU;
    namespace precisionTrigonometric = precisionPIConGPU;
} // namespace picongpu

#include "picongpu/unitless/precision.unitless"
