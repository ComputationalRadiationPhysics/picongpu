/** @file
 *
 * Initialize particles inside particle species. This is the final step in
 * setting up particles (defined in `speciesDefinition.param`) via density
 * profiles (defined in `density.param`). One can then further derive particles
 * from one species to another and manipulate attributes with "manipulators"
 * and "filters" (defined in `particle.param` and `particleFilters.param`).
 */

#pragma once

#include "picongpu/particles/InitFunctors.hpp"

#ifndef PARAM_START_ELECTRONS
#    define PARAM_START_ELECTRONS Corner1000ppc
#endif
#ifndef PARAM_START_IONS
#    define PARAM_START_IONS Corner1000ppc
#endif

namespace picongpu
{
    namespace particles
    {
        /** InitPipeline defines in which order species are initialized
         *
         * the functors are called in order (from first to last functor)
         */
        using InitPipeline = pmacc::mp_list<
            // Generate Densities
            CreateDensity<densityProfiles::Homogenous, startPosition::PARAM_START_ELECTRONS, Electrons>,
            CreateDensity<densityProfiles::Homogenous, startPosition::PARAM_START_IONS, Ions>,
            // Set initial temperatures
            Manipulate<manipulators::AddTemperatureElectrons, Electrons>,
            Manipulate<manipulators::AddTemperatureIons, Ions>>;
    } // namespace particles
} // namespace picongpu
