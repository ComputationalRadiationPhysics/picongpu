#
# generic compile options
#

################################################################################
# add presets here
#   - default: index 0
#   - start with zero index
#   - increase by 1, no gaps

flags[0]="-DPARAM_OVERWRITES:LIST='-DPARAM_PARTICLEPUSHER=HigueraCary;-DPARAM_PARTICLESHAPE=NGP;-DPARAM_CURRENTSOLVER=EmZ<UsedParticleShape>;-DPARAM_DIMENSION=DIM3;-DPARAM_PRECISION=precision64Bit;-DPARAM_FIELDSOLVER=Lehe<>;-DPARAM_SUBSTEPPINGSOLVER=0'"
flags[1]="-DPARAM_OVERWRITES:LIST='-DPARAM_PARTICLEPUSHER=Boris;-DPARAM_COMPOSITEPUSHER=1;-DPARAM_PARTICLESHAPE=CIC;-DPARAM_CURRENTSOLVER=EmZ<UsedParticleShape>;-DPARAM_DIMENSION=DIM2;-DPARAM_PRECISION=precision32Bit;-DPARAM_FIELDSOLVER=Lehe<>;-DPARAM_SUBSTEPPINGSOLVER=1'"

# limit examles if we run CI tests
if [ -z  "$PIC_CI_MAINLINE" ] ; then
  flags[2]="-DPARAM_OVERWRITES:LIST='-DPARAM_PARTICLEPUSHER=Vay;-DPARAM_PARTICLESHAPE=PQS;-DPARAM_CURRENTSOLVER=EZ<UsedParticleShape>;-DPARAM_DIMENSION=DIM3;-DPARAM_PRECISION=precision64Bit;-DPARAM_FIELDSOLVER=Yee;-DPARAM_SUBSTEPPINGSOLVER=0'"
  flags[3]="-DPARAM_OVERWRITES:LIST='-DPARAM_PARTICLEPUSHER=ReducedLandauLifshitz;-DPARAM_PARTICLESHAPE=TSC;-DPARAM_CURRENTSOLVER=Esirkepov<UsedParticleShape>;-DPARAM_DIMENSION=DIM3;-DPARAM_PRECISION=precision32Bit;-DPARAM_FIELDSOLVER=Yee;-DPARAM_SUBSTEPPINGSOLVER=1'"
  flags[4]="-DPARAM_OVERWRITES:LIST='-DPARAM_PARTICLEPUSHER=HigueraCary;-DPARAM_COMPOSITEPUSHER=1;-DPARAM_PARTICLESHAPE=PCS;-DPARAM_CURRENTSOLVER=EZ<UsedParticleShape>;-DPARAM_DIMENSION=DIM2;-DPARAM_PRECISION=precision32Bit;-DPARAM_FIELDSOLVER=Yee;-DPARAM_SUBSTEPPINGSOLVER=0'"
  flags[5]="-DPARAM_OVERWRITES:LIST='-DPARAM_PARTICLEPUSHER=Free;-DPARAM_PARTICLESHAPE=CIC;-DPARAM_CURRENTSOLVER=Esirkepov<UsedParticleShape>;-DPARAM_DIMENSION=DIM2;-DPARAM_PRECISION=precision32Bit;-DPARAM_FIELDSOLVER=Yee;-DPARAM_SUBSTEPPINGSOLVER=0'"
  flags[6]="-DPARAM_OVERWRITES:LIST='-DPARAM_PARTICLEPUSHER=Photon;-DPARAM_PARTICLESHAPE=TSC;-DPARAM_CURRENTSOLVER=EmZ<UsedParticleShape>;-DPARAM_DIMENSION=DIM3;-DPARAM_PRECISION=precision32Bit;-DPARAM_FIELDSOLVER=Yee;-DPARAM_SUBSTEPPINGSOLVER=0'"
  flags[7]="-DPARAM_OVERWRITES:LIST='-DPARAM_PARTICLEPUSHER=Probe;-DPARAM_PARTICLESHAPE=PQS;-DPARAM_CURRENTSOLVER=EZ<UsedParticleShape>;-DPARAM_DIMENSION=DIM3;-DPARAM_PRECISION=precision32Bit;-DPARAM_FIELDSOLVER=Yee;-DPARAM_SUBSTEPPINGSOLVER=0'"
  flags[8]="-DPARAM_OVERWRITES:LIST='-DPARAM_PARTICLEPUSHER=Acceleration;-DPARAM_PARTICLESHAPE=NGP;-DPARAM_CURRENTSOLVER=Esirkepov<UsedParticleShape>;-DPARAM_DIMENSION=DIM3;-DPARAM_PRECISION=precision64Bit;-DPARAM_FIELDSOLVER=Yee;-DPARAM_SUBSTEPPINGSOLVER=0'"
fi

################################################################################
# execution

case "$1" in
    -l)  echo ${#flags[@]}
         ;;
    -ll) for f in "${flags[@]}"; do echo $f; done
         ;;
    *)   echo -n ${flags[$1]}
         ;;
esac
