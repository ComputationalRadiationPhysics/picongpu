{
  "$id": "https://registry.hzdr.de/crp/picongpu/schema/picongpu.pypicongpu.simulation.Simulation",
  "type": "object",
  "description": "Holds all data associated with a single simulation run. Gets passed into the rendering engine.",
  "properties": {
    "delta_t_si": {
      "type": "number",
      "description": "width of a single timestamp in s"
    },
    "base_density": {
      "type": "number",
      "description": "PIConGPU unit system reference number density, used to normalize macro particle momenta and mass"
    },
    "time_steps": {
      "type": "integer",
      "minimum": 0,
      "description": "total number of time steps to run for"
    },
    "typical_ppc": {
      "type": "integer",
      "minimum": 1,
      "description": "typical number of macroparticles per cell, used for normalization"
    },
    "solver": {
      "anyOf": [
        {
          "$ref": "https://registry.hzdr.de/crp/picongpu/schema/picongpu.pypicongpu.field_solver.Yee.YeeSolver"
        },
        {
          "$ref": "https://registry.hzdr.de/crp/picongpu/schema/picongpu.pypicongpu.field_solver.Lehe.LeheSolver"
        }
      ]
    },
    "grid": {},
    "laser": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "https://registry.hzdr.de/crp/picongpu/schema/picongpu.pypicongpu.laser.Laser"
          }
        }
      ]
    },
    "moving_window": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://registry.hzdr.de/crp/picongpu/schema/picongpu.pypicongpu.movingwindow.MovingWindow"
        }
      ]
    },
    "walltime": {
      "$ref": "https://registry.hzdr.de/crp/picongpu/schema/picongpu.pypicongpu.walltime.Walltime"
    },
    "particle_filters": {},
    "collisional_physics": {},
    "binomial_current_interpolation": {
      "type": "boolean",
      "description": "use binomial current interpolation"
    },
    "synchrotron_params": {},
    "output": {
      "description": "configuration of simulation output",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "description": "list of plugins",
          "type": "array",
          "items": {
            "$ref": "https://registry.hzdr.de/crp/picongpu/schema/picongpu.pypicongpu.output.plugin.Plugin"
          }
        }
      ]
    },
    "customuserinput": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://registry.hzdr.de/crp/picongpu/schema/picongpu.pypicongpu.customrenderingcontext.CustomRenderingContext"
        }
      ]
    },
    "species": {},
    "init_operations": {}
  },
  "required": [
    "delta_t_si",
    "time_steps",
    "typical_ppc",
    "solver",
    "grid",
    "laser",
    "moving_window",
    "walltime",
    "collisional_physics",
    "particle_filters",
    "customuserinput",
    "output",
    "synchrotron_params",
    "base_density",
    "species"
  ],
  "unevaluatedProperties": false
}
