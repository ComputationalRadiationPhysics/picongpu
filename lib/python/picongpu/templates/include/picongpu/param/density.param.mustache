namespace picongpu
{
    namespace densityProfiles::pypicongpu
    {
        {{#init_operations}}{{#type_simpledensity}}
        // a species has always only exactly one profile, so only one of the following blocks below will be present

            {{#profile.type_gaussian}}
            /** generate the initial macroparticle position for species "{{{placed_species_initial.name}}}" ({{{placed_species_initial.typename}}})
             *
             * @note the density may be further modified from this profile by the densityRatio of the species, set in
             *  the init-pipeline.
             */
            struct init_{{{placed_species_initial.typename}}}_GaussianParam
            {
                static constexpr float_X gasFactor = {{{profile.gas_factor}}};
                static constexpr float_X gasPower  = {{{profile.gas_power}}};

                    //! height of vacuum area on top border, unit: cells
                    static constexpr uint32_t vacuumCellsY = {{{profile.vacuum_cells_front}}};

                    //! The edges of the constant center of the profile, unit: meter
                    static constexpr float_64 gasCenterLeft_SI  = {{{profile.gas_center_front}}};
                    static constexpr float_64 gasCenterRight_SI = {{{profile.gas_center_rear}}};

                    /** the distance from gasCenter_SI until the gas density decreases to its 1/e-th part
                     *  unit: meter
                     */
                    static constexpr float_64 gasSigmaLeft_SI  = {{{profile.gas_sigma_front}}};
                    static constexpr float_64 gasSigmaRight_SI = {{{profile.gas_sigma_rear}}};

                    //! factor to multiply BASE_DENSITY_SI by to get density
                    static constexpr float_X densityFactor
                        = static_cast<float_X>({{{profile.density}}} / SI::BASE_DENSITY_SI);
                };

            using init_{{{placed_species_initial.typename}}} = GaussianImpl<init_{{{placed_species_initial.typename}}}_GaussianParam>;
            {{/profile.type_gaussian}}

            {{#profile.type_uniform}}
            /** generate the initial macroparticle position for species "{{{placed_species_initial.name}}}" ({{{placed_species_initial.typename}}})
             *
             * @note the density may be further modified from this profile by the densityRatio of the species set in the
             *  init-pipeline.
             */
            struct init_{{{placed_species_initial.typename}}}_functor
            {
                /** generate the initial macroparticle position for species "{{{placed_species_initial.name}}}" ({{{placed_species_initial.typename}}})
                 *
                 * @note the density may be further modified from this profile by the densityRatio of the species, set in
                 *  the init-pipeline.
                 */
                HDINLINE float_X operator()(const floatD_64& position_SI, const float3_64& cellSize_SI)
                {
                    //! @todo respect bounding box, Brian Marre, 2023
                    return static_cast<float_X>({{{profile.density_si}}} / SI::BASE_DENSITY_SI);
                }
            };
            using init_{{{placed_species_initial.typename}}} = FreeFormulaImpl<init_{{{placed_species_initial.typename}}}_functor>;
            {{/profile.type_uniform}}

            {{#profile.type_foil}}
            /** generate the initial macroparticle position for species "{{{placed_species_initial.name}}}" ({{{placed_species_initial.typename}}})
             *
             * @note the density may be further modified from this profile by the densityRatio of the species, set in
             *  the init-pipeline.
             */
            struct init_{{{placed_species_initial.typename}}}_functor
            {
                HDINLINE float_X operator()(const floatD_64& position_SI, const float3_64& cellSize_SI)
                {
                    //! @todo respect bounding box, Brian Marre, 2023
                    float_64 const y = position_SI.y(); // m
                    float_X dens = 0._X; // in units of BASE_DENSITY_SI

                        // begin & end plateau of foil
                        constexpr float_64 y0 = {{{profile.y_value_front_foil_si}}};
                        constexpr float_64 y1 = y0 + {{{profile.thickness_foil_si}}};

                    // prePlasma ramp
                    {{#profile.pre_foil_plasmaRamp.type_exponential}}
                        // exponential pre-expanded density ramp before plateau of foil
                        constexpr float_64 prePlasmaLength = {{{profile.pre_foil_plasmaRamp.PlasmaLength}}};
                        constexpr float_64 prePlasmaCutoff = {{{profile.pre_foil_plasmaRamp.PlasmaCutoff}}};

                        // prefoil upramp
                        if((y < y0) &&  y > y0 - prePlasmaCutoff)
                            dens = static_cast<float_X>({{{profile.density_si}}} / SI::BASE_DENSITY_SI)
                                * math::exp((y - y0) / prePlasmaLength);
                    {{/profile.pre_foil_plasmaRamp.type_exponential}}

                    {{#profile.pre_foil_plasmaRamp.type_none}}
                        // no prePlasma ramp
                    {{/profile.pre_foil_plasmaRamp.type_none}}

                    // postPlasma ramp
                    {{#profile.post_foil_plasmaRamp.type_exponential}}
                        // exponential pre-expanded density ramp after plateau of foil
                        constexpr float_64 postPlasmaLength = {{{profile.post_foil_plasmaRamp.PlasmaLength}}};
                        constexpr float_64 postPlasmaCutoff = {{{profile.post_foil_plasmaRamp.PlasmaCutoff}}};
                    // postfoil downramp
                        if(y > y1 && y < y1 + postPlasmaCutoff)
                            dens = static_cast<float_X>({{{profile.density_si}}} / SI::BASE_DENSITY_SI)
                                * math::exp((y1 - y) / postPlasmaLength);
                    {{/profile.post_foil_plasmaRamp.type_exponential}}

                    {{#profile.post_foil_plasmaRamp.type_none}}
                        // no postPlasma ramp
                    {{/profile.post_foil_plasmaRamp.type_none}}

                        // foil plateau
                        if(y >= y0 && y <= y1)
                            dens = static_cast<float_X>({{{profile.density_si}}} / SI::BASE_DENSITY_SI);

                    // safety check: all parts of the function MUST be > 0
                    dens *= float_64(dens >= 0.0);
                    return dens;
                }
            };
            using init_{{{placed_species_initial.typename}}} = FreeFormulaImpl<init_{{{placed_species_initial.typename}}}_functor>;
            {{/profile.type_foil}}

            {{#profile.type_cylinder}}
            struct init_{{{placed_species_initial.typename}}}_CylindricalParam
            {
                static constexpr float3_64  centerPosition_SI{
                    {{{profile.center_position_si.0.component}}},
                    {{{profile.center_position_si.1.component}}},
                    {{{profile.center_position_si.2.component}}}
                };
                static constexpr float3_X jetAxis{
                    {{{profile.cylinder_axis.0.component}}}_X,
                    {{{profile.cylinder_axis.1.component}}}_X,
                    {{{profile.cylinder_axis.2.component}}}_X
                };
                static constexpr float_64 radius_SI = {{{profile.radius_si}}};
                static constexpr float_X densityFactor
                        = static_cast<float_X>({{{profile.density_si}}} / SI::BASE_DENSITY_SI);

                // Preplasma:
                {{#profile.pre_plasma_ramp.type_exponential}}
                static constexpr float_64 prePlasmaLength_SI = {{{profile.pre_plasma_ramp.PlasmaLength}}};
                static constexpr float_64 prePlasmaCutoff_SI = {{{profile.pre_plasma_ramp.PlasmaCutoff}}};
                {{/profile.pre_plasma_ramp.type_exponential}};

                {{#profile.pre_plasma_ramp.type_none}}
                static constexpr float_64 prePlasmaLength_SI = 0.0;
                static constexpr float_64 prePlasmaCutoff_SI = 0.0;
                {{/profile.pre_plasma_ramp.type_none}}
            };
            using init_{{{placed_species_initial.typename}}} = CylindricalImpl<init_{{{placed_species_initial.typename}}}_CylindricalParam>;
            {{/profile.type_cylinder}}

            {{#profile.type_freeformula}}
            struct init_{{{placed_species_initial.typename}}}_functor
            {
                /** This formula uses SI quantities only
                 *
                 * The profile will be multiplied by BASE_DENSITY.
                 *
                 * @param position_SI total offset including all slides [in meter]
                 * @param cellSize_SI cell sizes [in meter]
                 *
                 * @return float_X density [normalized to 1.0]
                 */
                HDINLINE float_X operator()(const floatD_64& position_SI, const float3_64& cellSize_SI)
                {
                  const auto [x, y, z] = position_SI;

                  return ({{{profile.function_body}}}) / SI::BASE_DENSITY_SI;
                }
            };
            using init_{{{placed_species_initial.typename}}} = FreeFormulaImpl<init_{{{placed_species_initial.typename}}}_functor>;
            {{/profile.type_freeformula}}

{{/type_simpledensity}}{{/init_operations}}
