#pragma once

#include <pmacc/meta/conversion/MakeSeq.hpp>

/* some forward declarations we need */
#include "picongpu/fields/Fields.def"
#include "picongpu/particles/filter/filter.def"
#include "picongpu/particles/particleToGrid/CombinedDerive.def"
#include "picongpu/particles/particleToGrid/ComputeGridValuePerFrame.def"

namespace picongpu
{
    namespace deriveField = particles::particleToGrid;

    namespace particles::particleToGrid::derivedAttributes {
{{#derived_field_functors}}

    struct {{{typename}}} {
         HDINLINE float1_64 getUnit() const
         {
             return 1.;
         }

         HINLINE std::vector<float_64> getUnitDimension() const
         {
             std::vector<float_64> unitDimension(7, 0.0);
             return unitDimension;
         }

         HINLINE static std::string getName()
         {
             return "{{{name}}}";
         }

         template<class T_Particle>
         DINLINE {{{return_type}}} operator()(T_Particle& particle) const
         {
              {{#functor_preamble}}
              {{{statement}}}
              {{/functor_preamble}}
              return {{{functor_expression}}};
         }

    };

    template<>
    struct IsWeighted<{{{typename}}}> : std::true_type {};
{{/derived_field_functors}}
    }

{{#field_tmp_solvers}}
    using {{{typename}}}_Attribute = {{{attribute_type}}};
    using {{{typename}}}_Filter = {{{filter_type}}};

    static_assert(
        particles::traits::SpeciesEligibleForSolver<
            {{{species}}},
            deriveField::FilteredDerivedAttribute<
                {{{typename}}}_Attribute,
                {{{typename}}}_Filter
            >
        >::type::value,
        "Derived field {{{attribute_typename}}} with filter {{{filter_type}}} is not supported for {{{species}}}"
    );

{{/field_tmp_solvers}}

    using FieldTmpSolvers = MakeSeq_t<
    {{#field_tmp_solvers}}
      deriveField::CreateFieldTmpOperation_t<
          {{{species}}},
          {{{typename}}}_Attribute,
          {{{typename}}}_Filter
      >{{^_last}},{{/_last}}
    {{/field_tmp_solvers}}
    >;


    using NativeFileOutputFields = MakeSeq_t<FieldE, FieldB, FieldJ>;
    using FileOutputFields = MakeSeq_t<NativeFileOutputFields, FieldTmpSolvers>;
    using FileOutputParticles = VectorAllSpecies;
} // namespace picongpu
