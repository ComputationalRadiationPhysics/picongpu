/** @file fieldIonizationCalc.def
 *
 * forward declarations for ionization algorithms
 * ionization model has a < Name >
 * so the algorithm is called "Algorithm< Name >"
 */

#pragma once

namespace picongpu
{
    namespace particles
    {
        namespace ionization
        {
            template<bool T_polarizationType>
            struct AlgorithmADK;

            struct AlgorithmBSI;

            struct AlgorithmBSIEffectiveZ;

            struct AlgorithmBSIStarkShifted;

            struct AlgorithmKeldysh;

        } // namespace ionization

    } // namespace particles

} // namespace picongpu
