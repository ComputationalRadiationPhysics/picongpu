#pragma once

#include "picongpu/particles/manipulators/generic/Free.hpp"

#include <pmacc/attribute/FunctionSpecifier.hpp>

namespace picongpu
{
    namespace particles
    {
        namespace manipulators
        {
            namespace generic
            {
                namespace acc
                {
                    struct None
                    {
                        template<typename T_Worker, typename T_Particle>
                        HDINLINE void operator()(T_Worker const&, T_Particle&)
                        {
                        }

                        static constexpr char const* name = "None";
                    };
                } // namespace acc

                /** do nothing with the particle
                 *
                 * The call of this functor results in an empty operation
                 */
                using None = Free<acc::None>;

            } // namespace generic
        } // namespace manipulators
    } // namespace particles
} // namespace picongpu
