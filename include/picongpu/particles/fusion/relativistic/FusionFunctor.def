#include "picongpu/particles/fusion/IBinary.def"
#pragma once

namespace picongpu
{
    namespace particles
    {
        namespace fusion
        {
            namespace relativistic
            {
                template<typename T_Param>
                struct FusionFunctorImpl;

                /** Host side binary collision functor for using a constant coulomb logarithm value
                 *
                 * @tparam T_Param param class with a static constexpr member 'CalcCrossSection'
                 */
                template<typename T_Param>
                using FusionFunctor = FusionFunctorImpl<T_Param>;
            } // namespace relativistic
        } // namespace fusion
    } // namespace particles
} // namespace picongpu
