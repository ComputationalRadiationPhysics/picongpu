                 * @tparam T_Distribution pmacc::random::distributions, random number distribution
                 */
                template<typename T_Functor, typename T_Distribution>
                struct FreeRng;

            } // namespace generic
        } // namespace startPosition
    } // namespace particles
} // namespace picongpu
